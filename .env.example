PORT=3000
NODE_ENV=development

# Comma-separated allowed browser origins. Leave blank for same-origin deployments.
FRONTEND_ORIGIN=

# Set TRUST_PROXY=true only when the app is behind a trusted single reverse proxy.
TRUST_PROXY=false

# IMEILookup REST API. Requests use POST /order/single and GET /order/single?id=...
# The API key is sent in the access-key header and never exposed to the browser.
IMEI_API_URL=https://api.imeilookup.com
IMEI_API_KEY=replace-with-provider-api-key
IMEI_SERVICE_ID=replace-with-your-account-service-id
IMEI_API_TIMEOUT_MS=70000

# Provider webhook authentication. Set a long random value in both this app and the provider.
# The receiver accepts X-IMEILookup-Signature: sha256=<HMAC-SHA256 of exact raw JSON bytes>
# or X-Webhook-Token / Authorization: Bearer <same secret>.
IMEI_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Optional comma-separated source IP allow-list. Set only to provider-published IPs.
IMEI_WEBHOOK_IPS=
# SQLite database file for orders and webhook event receipts.
DATABASE_PATH=data/imei-checker.sqlite
